---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import Intro from '@/components/Intro.astro';
import Anime from '@/components/Anime.astro';
import Dream from '@/components/Dream.astro';
import Works from '@/components/Works.astro';
import Contact from '@/components/Contact.astro';
import SlidePager from '@/components/SlidePager.astro';
import { translations } from '@/content/profile';

const locale = 'en';
const profile = translations[locale].profile;
---

<BaseLayout title={`Personal Homepage - ${profile.name}`} description={profile.abstract} locale={locale}>
  <Nav locale={locale} />
  <main>
    <Hero locale={locale} />
    <Intro locale={locale} />
    <Anime locale={locale} />
    <Dream locale={locale} />
    <Works locale={locale} />
    <Contact locale={locale} />
  </main>
  <SlidePager locale={locale} />
</BaseLayout>
