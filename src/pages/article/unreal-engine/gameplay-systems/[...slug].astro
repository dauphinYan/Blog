---
import { getCollection, type CollectionEntry } from 'astro:content';
import OfficialDocArticle from '../../../../components/OfficialDocArticle.astro';
import { articleUrlSlug, knowledgeBreadcrumb } from '../../../../data/unreal-gameplay';
import { buildUnrealDocsTree } from '../../../../data/unreal-docs';

interface Props { article: CollectionEntry<'gameplaySystems'>; }

export async function getStaticPaths() {
  const articles = await getCollection('gameplaySystems', ({ data }) => !data.draft);
  return articles.map(article => ({ params: { slug: articleUrlSlug(article.id) }, props: { article } }));
}

const { article } = Astro.props;
const slug = articleUrlSlug(article.id);
const tree = buildUnrealDocsTree(await getCollection('unrealCpp'), await getCollection('gameplaySystems'));
const breadcrumb = knowledgeBreadcrumb(tree, slug);
---
<OfficialDocArticle article={article} slug={slug} navigationTree={tree} breadcrumb={breadcrumb} pageTitle={`${article.data.title} - 游戏性系统中文专区`} decorRight="GAS" />
