---
import '../../styles/global.css';
import '../../styles/blog.css';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedDate = post.data.publishedAt.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={post.data.description} />
    <meta name="theme-color" content="#f7f6f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171a16" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{post.data.title} - Orca丶的博客</title>
  </head>
  <body class="page-with-paint-splashes">
    <header><div class="nav-inner"><nav aria-label="主导航"><a href="/#home">首页</a><a href="/#projects">项目</a><a href="/#blog" class="active" aria-current="page">博客</a><a href="/#about">关于</a><a href="/#contact">联系</a></nav></div></header>
    <aside class="article-toc" aria-label="文章目录" data-article-toc hidden>
      <p class="article-toc-label">ON THIS PAGE</p>
      <button class="article-toc-toggle" type="button" aria-expanded="true" aria-controls="article-toc-list">目录 <span aria-hidden="true">−</span></button>
      <nav id="article-toc-list" aria-label="文章章节"></nav>
    </aside>
    <div class="article-decor article-decor-left" aria-hidden="true"><span>+</span><i></i><b>001</b></div>
    <div class="article-decor article-decor-right" aria-hidden="true"><span>PLAY</span><i></i><b>///</b></div>
    <main class="blog-page">
      <article class="blog-post">
        <a class="back-link" href="/#blog">← 返回博客列表</a>
        <p class="post-eyebrow">{post.data.tags[0] ?? 'DEVLOG'} / {publishedDate}</p>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        {post.data.tags.length > 0 && <ul class="post-tags" aria-label="文章标签">{post.data.tags.map(tag => <li>{tag}</li>)}</ul>}
        <div class="article-body"><Content /></div>
      </article>
    </main>
    <button class="back-to-top" type="button" aria-label="回到页面顶部" data-back-to-top hidden>TOP ↑</button>
    <footer class="blog-footer"><span>本网站基于 Astro 构建</span><span>© 2026 Orca丶. 保留所有权利。</span></footer>
    <script>
      const backToTop = document.querySelector('[data-back-to-top]');
      if (backToTop instanceof HTMLButtonElement) {
        const updateBackToTopVisibility = () => {
          backToTop.hidden = window.scrollY < window.innerHeight;
        };

        updateBackToTopVisibility();
        window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
        backToTop.addEventListener('click', () => {
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
        });
      }

      const toc = document.querySelector('[data-article-toc]');
      const tocList = document.querySelector('#article-toc-list');
      const headings = [...document.querySelectorAll('.article-body h2, .article-body h3, .article-body h4')];

      const codeBlocks = [...document.querySelectorAll('.article-body pre.astro-code')];
      codeBlocks.forEach((codeBlock, index) => {
        if (!(codeBlock instanceof HTMLElement)) return;

        const codeToggle = document.createElement('button');
        const toggleId = `code-block-${index + 1}`;
        codeBlock.id ||= toggleId;
        codeToggle.type = 'button';
        codeToggle.className = 'code-block-toggle';
        codeToggle.setAttribute('aria-controls', codeBlock.id);
        codeToggle.setAttribute('aria-expanded', 'true');
        codeToggle.setAttribute('aria-label', '收起代码块');
        codeToggle.title = '收起代码块';
        codeToggle.textContent = '收起';
        codeToggle.addEventListener('click', () => {
          const collapsed = codeBlock.classList.toggle('is-collapsed');
          codeToggle.setAttribute('aria-expanded', String(!collapsed));
          codeToggle.setAttribute('aria-label', collapsed ? '展开代码块' : '收起代码块');
          codeToggle.title = collapsed ? '展开代码块' : '收起代码块';
          codeToggle.textContent = collapsed ? '展开' : '收起';
        });
        codeBlock.append(codeToggle);
      });

      if (toc instanceof HTMLElement && tocList instanceof HTMLElement && headings.length > 0) {
        const usedIds = new Set();
        const root = { level: 1, children: [] as { level: number; heading: HTMLElement; children: unknown[] }[] };
        const stack = [root];

        headings.forEach((heading, index) => {
          if (!heading.id) {
            const baseId = heading.textContent?.trim().toLowerCase().replace(/[^\w\u4e00-\u9fff]+/g, '-') || `section-${index + 1}`;
            let id = baseId;
            let suffix = 2;
            while (usedIds.has(id) || document.getElementById(id)) id = `${baseId}-${suffix++}`;
            heading.id = id;
          }
          usedIds.add(heading.id);

          const level = Number(heading.tagName.slice(1));
          while (stack.at(-1)!.level >= level) stack.pop();
          const item = { level, heading, children: [] as typeof root.children };
          stack.at(-1)!.children.push(item);
          stack.push(item);
        });

        const setBranchExpanded = (listItem: HTMLLIElement, expanded: boolean) => {
          const button = listItem.querySelector(':scope > .article-toc-branch');
          if (!(button instanceof HTMLButtonElement)) return;
          listItem.classList.toggle('is-collapsed', !expanded);
          button.setAttribute('aria-expanded', String(expanded));
          button.textContent = expanded ? '−' : '+';
        };

        const renderItems = (items: typeof root.children) => {
          const list = document.createElement('ul');
          items.forEach(item => {
            const listItem = document.createElement('li');
            const link = document.createElement('a');
            link.href = `#${item.heading.id}`;
            link.textContent = item.heading.textContent;
            link.dataset.tocTarget = item.heading.id;
            listItem.append(link);

            if (item.children.length > 0) {
              const button = document.createElement('button');
              button.type = 'button';
              button.className = 'article-toc-branch';
              button.setAttribute('aria-label', `展开或收起${item.heading.textContent}`);
              button.setAttribute('aria-expanded', 'false');
              button.textContent = '+';
              listItem.classList.add('is-collapsed');
              button.addEventListener('click', () => {
                const expanded = listItem.classList.contains('is-collapsed');
                button.dataset.manualState = expanded ? 'expanded' : 'collapsed';
                setBranchExpanded(listItem, expanded);
              });
              listItem.prepend(button);
              listItem.append(renderItems(item.children));
            }
            list.append(listItem);
          });
          return list;
        };

        tocList.append(renderItems(root.children));
        toc.hidden = false;

        const tocToggle = toc.querySelector('.article-toc-toggle');
        tocToggle?.addEventListener('click', () => {
          const collapsed = toc.classList.toggle('is-collapsed');
          tocToggle.setAttribute('aria-expanded', String(!collapsed));
          tocToggle.querySelector('span')!.textContent = collapsed ? '+' : '−';
        });

        const tocLinks = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-target]')];
        const branchItems = [...toc.querySelectorAll<HTMLLIElement>('li:has(> .article-toc-branch)')];
        const revealActivePath = (heading: Element) => {
          const activeLink = tocLinks.find(link => link.dataset.tocTarget === heading.id);
          const activePath = new Set<HTMLLIElement>();
          let listItem = activeLink?.closest('li');

          while (listItem instanceof HTMLLIElement) {
            if (listItem.querySelector(':scope > .article-toc-branch')) activePath.add(listItem);
            listItem = listItem.parentElement?.closest('li');
          }

          branchItems.forEach(branch => {
            const button = branch.querySelector(':scope > .article-toc-branch');
            if (!(button instanceof HTMLButtonElement)) return;
            if (activePath.has(branch)) {
              setBranchExpanded(branch, true);
            } else if (button.dataset.manualState !== 'expanded') {
              setBranchExpanded(branch, false);
            }
          });
        };
        const headingObserver = new IntersectionObserver(entries => {
          const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (!visible) return;
          tocLinks.forEach(link => link.classList.toggle('is-active', link.dataset.tocTarget === visible.target.id));
          revealActivePath(visible.target);
        }, { rootMargin: '-15% 0px -70%' });
        headings.forEach(heading => headingObserver.observe(heading));
      }
    </script>
  </body>
</html>
