---
interface Props {
  label?: string;
  ariaLabel?: string;
}

const { label = 'ON THIS PAGE', ariaLabel = '文章目录' } = Astro.props;
---
<aside class="article-toc" aria-label={ariaLabel} data-article-toc hidden>
  <p class="article-toc-label">{label}</p>
  <button class="article-toc-toggle" type="button" aria-expanded="true" aria-controls="article-toc-list">大纲 <span aria-hidden="true">−</span></button>
  <nav id="article-toc-list" data-article-toc-list aria-label="文章章节"></nav>
</aside>
