---
interface Props {
  label: string;
  title: string;
  ariaLabel: string;
  /** 目录内容由页面或客户端脚本提供；类型仅用于挂接各自的交互。 */
  kind: 'outline' | 'knowledge';
  placement?: 'floating' | 'embedded';
  hidden?: boolean;
}

const { label, title, ariaLabel, kind, placement = 'floating', hidden = false } = Astro.props;
const sidebarId = `article-sidebar-${kind}`;
---
<aside
  id={sidebarId}
  class:list={['article-sidebar', `article-sidebar--${kind}`, `article-sidebar--${placement}`]}
  aria-label={ariaLabel}
  data-article-sidebar={kind}
  hidden={hidden}
>
  <p class="article-sidebar-label">{label}</p>
  <h2 class="article-sidebar-title">{title}</h2>
  <slot />
</aside>
<button
  class="article-sidebar-toggle"
  type="button"
  aria-controls={sidebarId}
  aria-expanded="false"
  data-article-sidebar-toggle={kind}
  hidden={hidden}
>
  <span aria-hidden="true">☰</span>{kind === 'outline' ? '大纲' : '目录'}
</button>
