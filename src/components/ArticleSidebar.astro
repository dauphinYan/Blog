---
interface Props {
  label: string;
  title: string;
  ariaLabel: string;
  /** 目录内容由页面或客户端脚本提供；类型仅用于挂接各自的交互。 */
  kind: 'outline' | 'knowledge';
  side?: 'left' | 'right';
  placement?: 'floating' | 'embedded';
  hidden?: boolean;
  /** 知识库首页等页面在移动端可隐藏其辅助目录。 */
  hideOnMobile?: boolean;
  /** 移动端可将辅助目录替换为前往完整目录页的链接。 */
  mobileHref?: string;
  /** 在移动端将嵌入式侧栏作为按需展开的抽屉。 */
  mobileDrawer?: boolean;
}

const { label, title, ariaLabel, kind, side = 'left', placement = 'floating', hidden = false, hideOnMobile = false, mobileHref, mobileDrawer = false } = Astro.props;
const sidebarId = `article-sidebar-${kind}`;
---
<aside
  id={sidebarId}
  class:list={['article-sidebar', `article-sidebar--${kind}`, `article-sidebar--${placement}`, `article-sidebar--${side}`, { 'article-sidebar--mobile-hidden': hideOnMobile, 'article-sidebar--mobile-drawer': mobileDrawer }]}
  aria-label={ariaLabel}
  data-article-sidebar={kind}
  data-mobile-href={mobileHref}
  hidden={hidden}
>
  <p class="article-sidebar-label">{label}</p>
  <h2 class="article-sidebar-title">{title}</h2>
  <slot />
</aside>
