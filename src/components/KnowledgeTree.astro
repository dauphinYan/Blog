---
import '../styles/knowledge-tree.css';
import type { KnowledgeTreeNode } from '../data/knowledge-section';
import KnowledgeTree from './KnowledgeTree.astro';

interface Props {
  nodes: KnowledgeTreeNode[];
  currentSlug?: string;
  /** 提供时仅展开集合内的节点（含当前文章的路径），否则全部展开。 */
  openSlugs?: Set<string>;
  /** 专区文章链接构造函数，由使用方传入所属专区的路由。 */
  urlFor: (slug: string) => string;
}

const { nodes, currentSlug = '', openSlugs, urlFor } = Astro.props;
---
<ul class="knowledge-tree">
  {nodes.map(node => {
    const hasChildren = node.children.length > 0;
    const expanded = !openSlugs || openSlugs.has(node.slug);
    return (
      <li class:list={{ 'is-current': node.slug === currentSlug, 'is-folder': hasChildren, 'is-collapsed': hasChildren && !expanded }}>
        {hasChildren ? (
          <div class="knowledge-row">
            {node.published
              ? <a href={node.href ?? urlFor(node.slug)}>{node.title}</a>
              : <span>{node.title}</span>}
            <button class="knowledge-branch" type="button" aria-expanded={expanded ? 'true' : 'false'} aria-label={`展开或收起「${node.title}」`}>{expanded ? '−' : '+'}</button>
          </div>
        ) : node.published ? (
          <a href={node.href ?? urlFor(node.slug)}>{node.title}</a>
        ) : (
          <span>{node.title}{node.description && <em>{node.description}</em>}</span>
        )}
        {hasChildren && <KnowledgeTree nodes={node.children} currentSlug={currentSlug} openSlugs={openSlugs} urlFor={urlFor} />}
      </li>
    );
  })}
</ul>
