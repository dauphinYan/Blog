---
import '../styles/knowledge-article.css';
import { render, type CollectionEntry } from 'astro:content';
import ArticleDetailLayout from '../layouts/ArticleDetailLayout.astro';
import ArticleKnowledgeNav from './ArticleKnowledgeNav.astro';
import ArticleOutlineNav from './ArticleOutlineNav.astro';
import { knowledgeTreeOpenSlugs, type KnowledgeTreeNode } from '../data/knowledge-section';

interface Props {
  article: CollectionEntry<'unrealCpp'> | CollectionEntry<'gameplaySystems'>;
  slug: string;
  navigationTree: KnowledgeTreeNode[];
  breadcrumb: Array<{ title: string; href?: string }>;
  pageTitle: string;
  decorRight: string;
}

const { article, slug, navigationTree, breadcrumb, pageTitle, decorRight } = Astro.props;
const { Content } = await render(article);
const openSlugs = knowledgeTreeOpenSlugs(navigationTree, slug);
---
<ArticleDetailLayout
  pageTitle={pageTitle}
  title={article.data.title}
  description={article.data.description}
  eyebrow={`UE ${article.data.engineVersion} · 中文学习导读`}
  variant="knowledge"
  decorLeft="UE5"
  decorRight={decorRight}
  footerNote="内容为中文学习导读，官方文档版权归 Epic Games 所有。"
  footerCopyright="© 2026 Orca丶"
>
  <ArticleKnowledgeNav slot="leftSidebar" nodes={navigationTree} currentSlug={slug} openSlugs={openSlugs} />
  <ArticleOutlineNav slot="rightSidebar" />
  <div slot="preamble" class="knowledge-breadcrumb" role="navigation" aria-label="面包屑导航">
    {breadcrumb.map((item, index) => <>
      {index > 0 && <span aria-hidden="true">/</span>}
      {item.href ? <a href={item.href}>{item.title}</a> : <span aria-current="page">{item.title}</span>}
    </>)}
  </div>
  <dl slot="metadata" class="source-meta">
    <div><dt>官方原文</dt><dd><a href={article.data.sourceUrl}>{article.data.sourceTitle} ↗</a></dd></div>
    <div><dt>版本</dt><dd>Unreal Engine {article.data.engineVersion}</dd></div>
    <div><dt>核对日期</dt><dd>{article.data.reviewedAt.toLocaleDateString('zh-CN')}</dd></div>
  </dl>
  <Content />
</ArticleDetailLayout>
