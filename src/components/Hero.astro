---
import { translations, type Locale } from '@/content/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = translations[locale].profile;
---

<section id="welcome" class="section slide hero-band immersive-hero">
  <div class="container hero-content">
    <div class="hero-text animate-fade-up">
      <h1 class="display-xl" data-i18n="profile.title">{profile.title}</h1>
      <p class="hero-subtitle" data-i18n="profile.tagline">{profile.tagline}</p>
      <div class="hero-links">
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span>·</span>
        <a href={profile.links.bilibili} target="_blank" rel="noopener noreferrer">Bilibili</a>
        <span>·</span>
        <a href={`mailto:${profile.links.email}`}>Email</a>
      </div>
    </div>

    <div class="hero-status animate-fade-up delay-1">
      {profile.heroStatus.map((item, index) => (
        <p>
          <span data-i18n={`profile.heroStatus.${index}.label`}>{item.label}</span>
          <strong data-i18n={`profile.heroStatus.${index}.text`}>{item.text}</strong>
        </p>
      ))}
    </div>
  </div>
</section>
