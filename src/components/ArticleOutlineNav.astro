---
import '../styles/article-outline.css';
import ArticleSidebar from './ArticleSidebar.astro';

interface Props { side?: 'left' | 'right'; }
const { side = 'right' } = Astro.props;
---
<ArticleSidebar label="ON THIS PAGE" title="大纲" ariaLabel="文章大纲" kind="outline" side={side} hidden>
  <nav id="article-toc-list" data-article-toc-list aria-label="文章章节"></nav>
</ArticleSidebar>
