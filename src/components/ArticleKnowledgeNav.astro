---
import ArticleSidebar from './ArticleSidebar.astro';
import KnowledgeTree from './KnowledgeTree.astro';
import type { KnowledgeTreeNode } from '../data/knowledge-section';
import { unrealDocsHubPath } from '../data/unreal-docs';

interface Props {
  nodes: KnowledgeTreeNode[];
  currentSlug: string;
  openSlugs: Set<string>;
  side?: 'left' | 'right';
}
const { nodes, currentSlug, openSlugs, side = 'left' } = Astro.props;
---
<ArticleSidebar label="OFFICIAL DOCUMENTS" title="官方目录" ariaLabel="官方文档目录" kind="knowledge" side={side}>
  <nav id="knowledge-doc-nav" aria-label="虚幻引擎官方文档目录">
    <KnowledgeTree nodes={nodes} currentSlug={currentSlug} openSlugs={openSlugs} urlFor={() => `${unrealDocsHubPath}/`} />
  </nav>
</ArticleSidebar>
<script>
  import { initKnowledgeTree } from '../scripts/knowledge-tree';
  initKnowledgeTree();
</script>
